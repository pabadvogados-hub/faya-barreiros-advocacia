# =============================================================================
#  config/.env  -  copie este arquivo para config/.env e preencha.
#  NUNCA suba o config/.env para o GitHub (o .gitignore ja bloqueia).
#  Nada que estiver em branco aqui e usado: o sistema avisa e segue sem enviar.
# =============================================================================

# ---------- IA (obrigatorio para triagem, qualificacao e minutas) ----------
# Chave propria do escritorio: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Modelos (nao precisa mexer; estao aqui para dar para baratear depois)
MODELO_TRIAGEM=claude-sonnet-5
MODELO_EXTRACAO=claude-sonnet-5
MODELO_QUALIFICACAO=claude-sonnet-5
MODELO_PECAS=claude-opus-5

# ---------- Onde ficam as pastas dos clientes ----------
# Windows: Z:\CLIENTES  ou  \\SERVIDOR\CLIENTES  (sem barra no final)
# Em branco = usa a pasta CLIENTES dentro deste projeto
PASTA_CLIENTES_RAIZ=

# ---------- WhatsApp (D-API, cerca de R$ 90/mes) ----------
DAPI_SESSION=
DAPI_TOKEN=

# ---------- ADVBOX ----------
# Regra do escritorio: so vai para o ADVBOX depois que existe numero de processo
ADVBOX_API_TOKEN=
ADVBOX_TIPO_PROCESSO=
ADVBOX_FASE_INICIAL=

# ---------- Asaas (cobranca de honorarios) ----------
ASAAS_API_TOKEN=

# ---------- ZapSign (assinatura do contrato e da procuracao) ----------
ZAPSIGN_API_TOKEN=

# ---------- DJEN / PJe (intimacoes) ----------
# TODAS as inscricoes que aparecem nas intimacoes do escritorio, separadas por virgula
OABS_MONITORADAS=308385/SP,64723/BA,64518/BA
PRAZO_INTERNO_DIAS_ANTES=3
FERIADOS_EXTRAS=
RELATORIO_CLIENTE_DIAS=30

# ---------- Meta Ads (so leitura: custo por lead) ----------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---------- Transcricao da ligacao ----------
# Caminho 1 (sem custo): pip install faster-whisper   -> nao precisa de chave
# Caminho 2: chave da OpenAI, so se preferir a API
WHISPER_MODELO=small
OPENAI_API_KEY=

# Dados bancarios que saem no contrato tributario (nunca no repositorio)
CONTA_BANCARIA=
CHAVE_PIX=
